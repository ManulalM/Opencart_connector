<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_opencart_config_form" model="ir.ui.view">
        <field name="name">opencart.config.form</field>
        <field name="model">opencart.config</field>
        <field name="arch" type="xml">
            <form string="OpenCart Configuration">
                <header>
                    <button name="action_test_mysql"
                            string="Test MySQL"
                            type="object"
                            class="btn-primary"
                            icon="fa-database"/>
                    <button name="action_test_sftp"
                            string="Test SFTP"
                            type="object"
                            class="btn-secondary"
                            icon="fa-server"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="My OpenCart Store"/></h1>
                    </div>
                    <group>
                        <group string="General">
                            <field name="url" placeholder="https://mystore.com" widget="url"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="MySQL Connection">
                            <field name="db_host" placeholder="localhost"/>
                            <field name="db_port"/>
                            <field name="db_user"/>
                            <field name="db_password" password="True"/>
                            <field name="db_name"/>
                            <field name="db_table_prefix" placeholder="oc_"/>
                        </group>
                    </group>
                    <group>
                        <group string="SFTP (Image Sync)">
                            <field name="sftp_host" placeholder="Same as MySQL host if empty"/>
                            <field name="sftp_port"/>
                            <field name="sftp_user"/>
                            <field name="sftp_password" password="True"/>
                            <field name="opencart_image_path" placeholder="/var/www/html/opencart/image/"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_opencart_config_list" model="ir.ui.view">
        <field name="name">opencart.config.list</field>
        <field name="model">opencart.config</field>
        <field name="arch" type="xml">
            <list string="OpenCart Configurations">
                <field name="name"/>
                <field name="url" widget="url"/>
                <field name="db_host"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_opencart_config" model="ir.actions.act_window">
        <field name="name">OpenCart Configuration</field>
        <field name="res_model">opencart.config</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
