<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_opencart_customer_sync_list" model="ir.ui.view">
        <field name="name">opencart.customer.sync.list</field>
        <field name="model">opencart.customer.sync</field>
        <field name="arch" type="xml">
            <list string="Customer Sync" create="false">
                <field name="opencart_customer_id"/>
                <field name="partner_id"/>
                <field name="last_sync"/>
                <field name="sync_status"
                       decoration-success="sync_status == 'success'"
                       decoration-danger="sync_status == 'failed'"
                       widget="badge"/>
                <field name="sync_message"/>
            </list>
        </field>
    </record>

    <record id="action_opencart_customer_sync" model="ir.actions.act_window">
        <field name="name">Customer Sync</field>
        <field name="res_model">opencart.customer.sync</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
