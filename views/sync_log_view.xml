<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Search View -->
    <record id="view_opencart_sync_log_search" model="ir.ui.view">
        <field name="name">opencart.sync.log.search</field>
        <field name="model">opencart.sync.log</field>
        <field name="arch" type="xml">
            <search string="Sync Logs">
                <field name="summary"/>
                <field name="detail"/>
                <field name="odoo_ref"/>
                <field name="opencart_ref"/>
                <separator/>
                <filter name="success" string="Success" domain="[('status', '=', 'success')]"/>
                <filter name="failed" string="Failed" domain="[('status', '=', 'failed')]"/>
                <separator/>
                <filter name="product" string="Products" domain="[('sync_type', '=', 'product')]"/>
                <filter name="order" string="Orders" domain="[('sync_type', '=', 'order')]"/>
                <filter name="customer" string="Customers" domain="[('sync_type', '=', 'customer')]"/>
                <filter name="stock" string="Stock" domain="[('sync_type', '=', 'stock')]"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[('create_date', '&gt;=', (context_today()).strftime('%%Y-%%m-%%d 00:00:00'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_type" string="Sync Type" context="{'group_by': 'sync_type'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- List View -->
    <record id="view_opencart_sync_log_list" model="ir.ui.view">
        <field name="name">opencart.sync.log.list</field>
        <field name="model">opencart.sync.log</field>
        <field name="arch" type="xml">
            <list string="Sync Logs" create="false" edit="false"
                  decoration-danger="status == 'failed'"
                  decoration-success="status == 'success'">
                <field name="create_date" string="Time"/>
                <field name="sync_type" widget="badge"/>
                <field name="direction"/>
                <field name="summary"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'success'"
                       decoration-danger="status == 'failed'"/>
                <field name="odoo_ref" optional="hide"/>
                <field name="opencart_ref" optional="hide"/>
                <field name="duration" optional="hide" widget="float_time"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_opencart_sync_log_form" model="ir.ui.view">
        <field name="name">opencart.sync.log.form</field>
        <field name="model">opencart.sync.log</field>
        <field name="arch" type="xml">
            <form string="Sync Log Entry" create="false" edit="false">
                <sheet>
                    <div class="oe_title mb-3">
                        <h1><field name="summary" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Details">
                            <field name="sync_type" readonly="1"/>
                            <field name="direction" readonly="1"/>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'success'"
                                   decoration-danger="status == 'failed'"
                                   readonly="1"/>
                            <field name="create_date" string="Timestamp" readonly="1"/>
                            <field name="duration" readonly="1"/>
                        </group>
                        <group string="References">
                            <field name="odoo_ref" readonly="1"/>
                            <field name="opencart_ref" readonly="1"/>
                        </group>
                    </group>
                    <group string="Message / Error">
                        <field name="detail" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_opencart_sync_log" model="ir.actions.act_window">
        <field name="name">Sync Logs</field>
        <field name="res_model">opencart.sync.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_opencart_sync_log_search"/>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No sync logs yet.
            </p>
            <p>Logs will appear here as syncs run.</p>
        </field>
    </record>

</odoo>
